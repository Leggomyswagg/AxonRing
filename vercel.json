{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/catalog.js": { "maxDuration": 60 },
    "api/checkout.js": { "maxDuration": 60 }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(?:[a-z0-9-]+\\.)*axonring\\.(?:net|shop)$"
        }
      ],
      "mitigate": { "action": "deny" }
    },
    { "handle": "filesystem" }
  ]
}

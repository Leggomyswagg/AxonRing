# Configure these as server-only Vercel variables. Never prefix secrets with VITE_.
# Enable only after the Shopify/CJ supplier, paid-order and tracking gates are verified.
AXONRING_COMMERCE_ENABLED=false
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Optional only if Shopify returns a custom hosted-checkout/policy domain.
SHOPIFY_CHECKOUT_DOMAIN=
CJ_SHOP_ID=
CJ_API_KEY=
# Use a current token only when no API key is configured.
CJ_ACCESS_TOKEN=
# Each record must use actual linked variants; no example product IDs are active.
# Fields: id, productKey (core|prestige), size, shopifyProductId,
# shopifyVariantId, cjProductId, cjVariantId.
AXONRING_CJ_VARIANTS=[]

# Copy to .env.local for local dev, and set the same values in
# Vercel → Settings → Environment Variables for deploys.
#
# ⚠️  Everything prefixed VITE_ is compiled into the browser bundle.
#     Only ever put PUBLISHABLE keys here.
#     The Supabase service_role key and the Stripe secret key must NEVER
#     appear in this file — they belong in Supabase Edge Function secrets.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Stripe publishable key (safe in the browser by design).
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_xxxxxxxxxxxx
